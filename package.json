{
  "name": "bioadapt-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "vite build && XDG_CONFIG_HOME=.config cap sync android",
    "android:run": "vite build && XDG_CONFIG_HOME=.config cap run android",
    "android:apk": "vite build && XDG_CONFIG_HOME=.config cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "XDG_CONFIG_HOME=.config cap open android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor-community/keep-awake": "^6.0.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
